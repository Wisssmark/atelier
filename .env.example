# Copy this file to ".env" and change the values before going live.

# Port the server listens on
PORT=4000

# REQUIRED in production. Long random string (32+ chars) used to sign admin
# login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Default admin account created on first run.
# Set a strong password BEFORE the first start, or change it immediately
# after first login under Account in the dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to "production" when deployed (enables secure cookies, HSTS, and
# refuses to start without a proper JWT_SECRET).
# NODE_ENV=production

# Where the SQLite database file lives (optional, defaults to ./data/atelier.sqlite).
# On a host with a persistent volume, point this at the volume, e.g. /data/atelier.sqlite
# DB_PATH=./data/atelier.sqlite
